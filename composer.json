{
  "name": "binestech/bines-staging-guard",
  "description": "BINES staging guard: badge, mail catch, outbound HTTP firewall, noindex on non-production sites.",
  "type": "wordpress-muplugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.3",
    "composer/installers": "^2.0"
  },
  "require-dev": {
    "pestphp/pest": "^4.0",
    "brain/monkey": "^2.6",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload-dev": {
    "psr-4": { "BinesGuard\\": "src/" }
  },
  "config": {
    "allow-plugins": { "composer/installers": true, "pestphp/pest-plugin": true },
    "sort-packages": true
  },
  "scripts": {
    "lint": "phpcs",
    "test": "pest"
  },
  "archive": {
    "exclude": [
      "/vendor",
      "/tests",
      "/.github",
      "/.gitignore",
      "/.phpunit.cache",
      "/phpunit.xml.dist",
      "/phpcs.xml",
      "/patchwork.json"
    ]
  }
}
